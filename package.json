{
  "name": "react-reader-diary",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build",
    "build:prod": "npm run build",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "seed": "npm --workspace server run seed",
    "start": "concurrently \"npm:start:server\" \"npm:start:client\"",
    "start:client": "npm --workspace client run start",
    "start:server": "npm --workspace server run start",
    "start:prod": "node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "ssh2": "^1.17.0"
  }
}
